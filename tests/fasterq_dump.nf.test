/*
 * Process-level tests for FASTERQ_DUMP.
 *
 * These tests use Nextflow stub mode:
 *   - no SRA Toolkit installation is required
 *   - no real FASTQ conversion happens
 *   - no network access is required
 */

def rootDir = new File(".").canonicalFile

def fixtureDir = new File(
    rootDir,
    ".nf-test/generated-fasterq-dump"
)

fixtureDir.mkdirs()


def makeSraDir = { String accession ->
    def dir = new File(fixtureDir, accession)
    dir.mkdirs()

    def sraFile = new File(dir, "${accession}.sra")
    sraFile.text = "stub SRA file\n"

    dir
}


def pairedSraDir = makeSraDir("SRR6357070")
def singleSraDir = makeSraDir("SRR1111111")
def secondSraDir = makeSraDir("ERR123456")


nextflow_process {

    name "Test FASTERQ_DUMP"
    tag "ci"

    script "../modules/local/fasterq_dump/main.nf"
    process "FASTERQ_DUMP"

    options "-stub-run"


    test("Should create paired-end compressed FASTQ files") {

        when {
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        [id: 'sample1'],
                        'SRR6357070',
                        file('${pairedSraDir.canonicalPath}', checkIfExists: true)
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0
            assert process.trace.tasks().size() == 1

            with(process.out.reads) {

                assert size() == 1

                def result = get(0)
                def meta   = result[0]
                def reads  = result[1] instanceof List ? result[1] : [result[1]]

                assert meta.id == 'sample1'
                assert reads.size() == 2

                def filenames = reads.collect {
                    new File(it.toString()).name
                }.sort()

                assert filenames == [
                    'SRR6357070_1.fastq.gz',
                    'SRR6357070_2.fastq.gz'
                ]
            }
        }
    }


    test("Should create a single-end compressed FASTQ file") {

        when {
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        [
                            id: 'sample1',
                            stub_single_end: true
                        ],
                        'SRR1111111',
                        file('${singleSraDir.canonicalPath}', checkIfExists: true)
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0

            with(process.out.reads) {

                assert size() == 1

                def result = get(0)
                def reads  = result[1] instanceof List ? result[1] : [result[1]]

                assert reads.size() == 1
                assert new File(reads[0].toString()).name == 'SRR1111111.fastq.gz'
            }
        }
    }


    test("Should preserve sample metadata") {

        when {
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        [
                            id: 'sample1',
                            condition: 'treated',
                            batch: 'batch1'
                        ],
                        'SRR6357070',
                        file('${pairedSraDir.canonicalPath}', checkIfExists: true)
                    )
                )
                """
            }
        }

        then {
            assert process.success

            with(process.out.reads) {

                assert size() == 1

                def meta = get(0)[0]

                assert meta.id == 'sample1'
                assert meta.condition == 'treated'
                assert meta.batch == 'batch1'
            }
        }
    }


    test("Should process multiple SRA accessions independently") {

        when {
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        [id: 'sample1'],
                        'SRR6357070',
                        file('${pairedSraDir.canonicalPath}', checkIfExists: true)
                    ),
                    tuple(
                        [id: 'sample2'],
                        'ERR123456',
                        file('${secondSraDir.canonicalPath}', checkIfExists: true)
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assert process.trace.tasks().size() == 2
            assert process.out.reads.size() == 2

            def sampleIds = process.out.reads
                .collect { it[0].id }
                .sort()

            assert sampleIds == [
                'sample1',
                'sample2'
            ]
        }
    }
}
