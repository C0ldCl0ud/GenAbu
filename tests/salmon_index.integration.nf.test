/*
 * Real integration test for SALMON_INDEX.
 *
 * This creates a tiny synthetic transcriptome and genome and verifies
 * that Salmon can build a real decoy-aware index.
 *
 * The resulting index must also be persisted into the supplied cache
 * directory.
 *
 * Run with:
 *
 *   nf-test test \
 *       tests/salmon_index.integration.nf.test \
 *       --profile docker
 */

def rootDir = new File(".").canonicalFile

def fixtureDir = new File(
    rootDir,
    ".nf-test/generated-salmon-index-integration"
)

fixtureDir.deleteDir()
fixtureDir.mkdirs()


def writeGzip = { File target, String content ->

    target.parentFile.mkdirs()

    def output = new java.util.zip.GZIPOutputStream(
        new java.io.FileOutputStream(target)
    )

    try {
        output.write(
            content.getBytes("UTF-8")
        )
    }
    finally {
        output.close()
    }
}


/*
 * Sequences comfortably exceed k = 31.
 */
def transcriptFasta = new File(
    fixtureDir,
    "transcripts.fa.gz"
)

writeGzip(
    transcriptFasta,
    """\
>tx1
ACGTTGCAACGTTGCAACGTTGCAACGTTGCAACGTTGCAACGTTGCAACGTTGCAACGTTGCA
>tx2
TTGCAAGCTTGCAAGCTTGCAAGCTTGCAAGCTTGCAAGCTTGCAAGCTTGCAAGCTTGCAAGC
""".stripIndent()
)


def genomeFasta = new File(
    fixtureDir,
    "genome.fa.gz"
)

writeGzip(
    genomeFasta,
    """\
>chr1 synthetic chromosome
GGGGAAAACCCCTTTTGGGGAAAACCCCTTTTGGGGAAAACCCCTTTTGGGGAAAACCCCTTTTGGGGAAAACCCCTTTT
""".stripIndent()
)


def salmonCache = new File(
    fixtureDir,
    "salmon-cache"
)

salmonCache.mkdirs()


nextflow_process {

    name "Test SALMON_INDEX integration"
    tag "integration"

    script "../modules/local/salmon_index/main.nf"
    process "SALMON_INDEX"


    test("Should build and cache a real decoy-aware Salmon index") {

        when {
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        [
                            id: 'synthetic',
                            species: 'Synthetic test',
                            assembly: 'test1',
                            source: 'GenAbu',
                            release: 1
                        ],
                        file(
                            '${transcriptFasta.canonicalPath}',
                            checkIfExists: true
                        ),
                        file(
                            '${genomeFasta.canonicalPath}',
                            checkIfExists: true
                        ),
                        '${salmonCache.canonicalPath}'
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0
            assert process.trace.tasks().size() == 1


            with(process.out.index) {

                assert size() == 1

                def result = get(0)

                def reference = result[0]

                def indexDir = path(
                    result[1]
                ).toFile()

                assert reference.id ==
                    'synthetic'

                assert indexDir.name ==
                    'salmon_index'

                assert indexDir.isDirectory()


                def info = new File(
                    indexDir,
                    'info.json'
                )

                def refseq = new File(
                    indexDir,
                    'refseq.bin'
                )

                def offsets = new File(
                    indexDir,
                    'refseq_offsets.json'
                )


                assert info.exists()
                assert info.length() > 0

                assert refseq.exists()
                assert refseq.length() > 0

                assert offsets.exists()
                assert offsets.length() > 0


                assert indexDir.listFiles().size() >= 5
            }


            /*
             * Verify persistent cache publication.
             */
            def cachedIndex = new File(
                salmonCache,
                'salmon_index'
            )

            assert cachedIndex.isDirectory()


            def cachedInfo = new File(
                cachedIndex,
                'info.json'
            )

            def cachedRefseq = new File(
                cachedIndex,
                'refseq.bin'
            )

            def cachedOffsets = new File(
                cachedIndex,
                'refseq_offsets.json'
            )


            assert cachedInfo.exists()
            assert cachedInfo.length() > 0

            assert cachedRefseq.exists()
            assert cachedRefseq.length() > 0

            assert cachedOffsets.exists()
            assert cachedOffsets.length() > 0


            with(process.out.versions) {

                assert size() == 1

                def versions = path(
                    get(0)
                ).toFile()

                assert versions.exists()
                assert versions.text.contains(
                    'salmon:'
                )
            }
        }
    }
}