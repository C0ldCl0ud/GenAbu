nextflow_process {

    name "SRA_PREFETCH network test"
    tag "network"

    script "../modules/local/sra_prefetch/main.nf"
    process "SRA_PREFETCH"

    test("Should download a real SRA accession") {

        when {
            process {
                """
                input[0] = Channel.of(
                    [[id: 'sample1'], 'SRR6357070']
                )
                """
            }
        }

        then {
            assert process.success

            with(process.out.sra) {
                assert size() == 1

                def result = get(0)

                assert result[0].id == 'sample1'
                assert result[1].getName() == 'SRR6357070'
                assert result[1].isDirectory()
            }
        }
    }
}