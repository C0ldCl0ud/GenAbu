/*
 * Real integration test for MULTIQC.
 *
 * This test feeds raw and trimmed Falco / FastQC-compatible
 * data files into MultiQC.
 *
 * It verifies that:
 *
 *   - the GenAbu MultiQC configuration is loaded
 *   - raw read QC is parsed
 *   - post-trimming read QC is parsed separately
 *   - the configured section names appear in the report
 *   - the raw QC section appears before the trimmed QC section
 *
 * Run with:
 *
 *   nf-test test tests/multiqc.integration.nf.test \
 *       --profile docker
 */

def rootDir = new File(".").canonicalFile

def fixtureDir = new File(
    rootDir,
    ".nf-test/generated-multiqc-integration"
)

fixtureDir.deleteDir()
fixtureDir.mkdirs()


def multiqcConfig = new File(
    rootDir,
    "assets/multiqc_config.yml"
).canonicalPath


def makeFalcoReport = {
    String filename,
    String readFilename,
    int totalSequences,
    int gc ->

    def file = new File(
        fixtureDir,
        filename
    )

    file.text = """\
##Falco\t2.0.2
>>Basic Statistics\tpass
#Measure\tValue
Filename\t${readFilename}
File type\tConventional base calls
Encoding\tSanger / Illumina 1.9
Total Sequences\t${totalSequences}
Sequences flagged as poor quality\t0
Sequence length\t100
%GC\t${gc}
>>END_MODULE
""".stripIndent()

    file
}


// =============================================================================
// Raw-read Falco reports
// =============================================================================

def rawR1 = makeFalcoReport(
    "sample1_R1_fastqc_data.txt",
    "sample1_R1.fastq.gz",
    1000,
    48
)

def rawR2 = makeFalcoReport(
    "sample1_R2_fastqc_data.txt",
    "sample1_R2.fastq.gz",
    1000,
    51
)


// =============================================================================
// Post-trimming Falco reports
// =============================================================================

def trimmedR1 = makeFalcoReport(
    "sample1_R1_trimmed_fastqc_data.txt",
    "sample1_R1.trimmed.fastq.gz",
    950,
    49
)

def trimmedR2 = makeFalcoReport(
    "sample1_R2_trimmed_fastqc_data.txt",
    "sample1_R2.trimmed.fastq.gz",
    950,
    50
)


nextflow_process {

    name "Test MULTIQC integration"
    tag "integration"

    script "../modules/local/multiqc/main.nf"
    process "MULTIQC"


    test("Should separate raw and trimmed read QC using GenAbu config") {

        when {
            process {
                """
                input[0] = Channel.of(
                    [
                        file(
                            '${rawR1.canonicalPath}',
                            checkIfExists: true
                        ),
                        file(
                            '${rawR2.canonicalPath}',
                            checkIfExists: true
                        ),
                        file(
                            '${trimmedR1.canonicalPath}',
                            checkIfExists: true
                        ),
                        file(
                            '${trimmedR2.canonicalPath}',
                            checkIfExists: true
                        )
                    ]
                )

                input[1] = Channel.value(
                    file(
                        '${multiqcConfig}',
                        checkIfExists: true
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0
            assert process.trace.tasks().size() == 1


            with(process.out.report) {

                assert size() == 1

                def report = path(
                    get(0)
                ).toFile()

                assert report.exists()

                assert report.name ==
                    'multiqc_report.html'


                def html = report.text


                /*
                 * Verify that our custom report configuration
                 * was actually loaded.
                 */
                assert html.contains(
                    'GenAbu RNA-seq Report'
                )


                /*
                 * The same FastQC-compatible module is run twice
                 * with different path filters.
                 */
                assert html.contains(
                    'Read QC — Raw'
                )

                assert html.contains(
                    'Read QC — After trimming'
                )


                /*
                 * Verify that data from both stages was parsed.
                 */
                assert html.contains(
                    'sample1_R1'
                )

                assert html.contains(
                    'sample1_R2'
                )

                assert html.contains(
                    'sample1_R1.trimmed'
                )

                assert html.contains(
                    'sample1_R2.trimmed'
                )


                /*
                 * Raw QC must appear before post-trimming QC
                 * according to module_order.
                 */
                def rawIndex = html.indexOf(
                    'Read QC — Raw'
                )

                def trimmedIndex = html.indexOf(
                    'Read QC — After trimming'
                )

                assert rawIndex >= 0
                assert trimmedIndex >= 0
                assert rawIndex < trimmedIndex
            }


            with(process.out.data) {

                assert size() == 1

                def dataDir = path(
                    get(0)
                ).toFile()

                assert dataDir.isDirectory()


                /*
                 * A real MultiQC run should create populated
                 * machine-readable output.
                 *
                 * Do not depend on a specific FastQC data filename
                 * here because two configured instances of the
                 * FastQC module may use different output names.
                 */
                def dataFiles = dataDir.listFiles()

                assert dataFiles != null
                assert dataFiles.size() > 0
            }


            with(process.out.versions) {

                assert size() == 1

                def versions = path(
                    get(0)
                ).toFile()

                assert versions.exists()

                assert versions.text.contains(
                    'multiqc:'
                )
            }
        }
    }
}