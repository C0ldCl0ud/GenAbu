/*
 * Tests for the INPUT_VALIDATOR subworkflow.
 *
 * Supported input types:
 *
 * FASTQ:
 *   Required columns:
 *     sample
 *     fastq_1
 *     fastq_2
 *
 * SRA:
 *   Required columns:
 *     sample
 *     accession
 *
 * Additional metadata columns are allowed.
 * Column order does not matter.
 *
 */

def rootDir = new File(".").canonicalFile

def fastq1 = new File(
    rootDir,
    "tests/data/SRR6357070_1.fastq.gz"
).canonicalPath

def fastq2 = new File(
    rootDir,
    "tests/data/SRR6357070_2.fastq.gz"
).canonicalPath

def fixtureDir = new File(
    rootDir,
    ".nf-test/generated-input-validation"
)

fixtureDir.mkdirs()


def makeCsv = { String filename, String content ->
    def file = new File(fixtureDir, filename)
    file.text = content.stripIndent()
    file
}


// =============================================================================
// Valid FASTQ fixtures
// =============================================================================

def validPaired = makeCsv(
    "valid_paired.csv",
    """\
sample,fastq_1,fastq_2
sample1,${fastq1},${fastq2}
"""
)

def validSingle = makeCsv(
    "valid_single.csv",
    """\
sample,fastq_1,fastq_2
sample1,${fastq1},
"""
)

def validFastqExtraColumns = makeCsv(
    "valid_fastq_extra_columns.csv",
    """\
sample,fastq_1,fastq_2,condition,batch
sample1,${fastq1},${fastq2},treated,batch1
"""
)

def validFastqReorderedColumns = makeCsv(
    "valid_fastq_reordered_columns.csv",
    """\
fastq_2,sample,fastq_1
${fastq2},sample1,${fastq1}
"""
)


// =============================================================================
// Invalid FASTQ fixtures
// =============================================================================

def missingSampleColumn = makeCsv(
    "invalid_missing_sample_column.csv",
    """\
fastq_1,fastq_2
${fastq1},${fastq2}
"""
)

def missingFastq1Column = makeCsv(
    "invalid_missing_fastq1_column.csv",
    """\
sample,fastq_2
sample1,${fastq2}
"""
)

def missingFastq2Column = makeCsv(
    "invalid_missing_fastq2_column.csv",
    """\
sample,fastq_1
sample1,${fastq1}
"""
)

def emptySample = makeCsv(
    "invalid_empty_sample.csv",
    """\
sample,fastq_1,fastq_2
,${fastq1},${fastq2}
"""
)

def emptyFastq1 = makeCsv(
    "invalid_empty_fastq1.csv",
    """\
sample,fastq_1,fastq_2
sample1,,${fastq2}
"""
)

def sampleWithWhitespace = makeCsv(
    "invalid_sample_whitespace.csv",
    """\
sample,fastq_1,fastq_2
sample one,${fastq1},${fastq2}
"""
)

def nonexistentFastqPath = new File(
    fixtureDir,
    "does_not_exist.fastq.gz"
).canonicalPath

def nonexistentFastq = makeCsv(
    "invalid_nonexistent_fastq.csv",
    """\
sample,fastq_1,fastq_2
sample1,${nonexistentFastqPath},${fastq2}
"""
)

def wrongExtensionFile = new File(
    fixtureDir,
    "reads.txt"
)

wrongExtensionFile.text = "This file deliberately has the wrong extension.\n"

def invalidFastqExtension = makeCsv(
    "invalid_fastq_extension.csv",
    """\
sample,fastq_1,fastq_2
sample1,${wrongExtensionFile.canonicalPath},${fastq2}
"""
)


// =============================================================================
// Valid SRA fixtures
// =============================================================================

def validSrr = makeCsv(
    "valid_srr.csv",
    """\
sample,accession
sample1,SRR6357070
"""
)

def validErr = makeCsv(
    "valid_err.csv",
    """\
sample,accession
sample1,ERR123456
"""
)

def validDrr = makeCsv(
    "valid_drr.csv",
    """\
sample,accession
sample1,DRR123456
"""
)

def validSraExtraColumns = makeCsv(
    "valid_sra_extra_columns.csv",
    """\
sample,accession,condition,batch
sample1,SRR6357070,treated,batch1
"""
)

def validSraReorderedColumns = makeCsv(
    "valid_sra_reordered_columns.csv",
    """\
accession,condition,sample
SRR6357070,treated,sample1
"""
)


// =============================================================================
// Invalid SRA fixtures
// =============================================================================

def sraMissingSampleColumn = makeCsv(
    "invalid_sra_missing_sample_column.csv",
    """\
accession
SRR6357070
"""
)

def sraMissingAccessionColumn = makeCsv(
    "invalid_sra_missing_accession_column.csv",
    """\
sample
sample1
"""
)

def emptyAccession = makeCsv(
    "invalid_sra_empty_accession.csv",
    """\
sample,accession
sample1,
"""
)

def unsupportedSraAccession = makeCsv(
    "invalid_sra_accession_type.csv",
    """\
sample,accession
sample1,SRP123456
"""
)

def malformedSraAccession = makeCsv(
    "invalid_sra_malformed_accession.csv",
    """\
sample,accession
sample1,SRRABC123
"""
)

def sraSampleWithWhitespace = makeCsv(
    "invalid_sra_sample_whitespace.csv",
    """\
sample,accession
sample one,SRR6357070
"""
)


// =============================================================================
// Input-type detection fixtures
// =============================================================================

def ambiguousInput = makeCsv(
    "invalid_ambiguous_input.csv",
    """\
sample,accession,fastq_1,fastq_2
sample1,SRR6357070,${fastq1},${fastq2}
"""
)

def unknownInput = makeCsv(
    "invalid_unknown_input.csv",
    """\
sample,url
sample1,https://example.org/reads.fastq.gz
"""
)

def nonexistentSamplesheet = new File(
    fixtureDir,
    "samplesheet_does_not_exist.csv"
)


// =============================================================================
// nf-test specification
// =============================================================================

nextflow_workflow {

    name "Input validator"
    tag "ci"

    script "../subworkflows/local/input_validator/main.nf"
    workflow "INPUT_VALIDATOR"


    // =========================================================================
    // Valid FASTQ inputs
    // =========================================================================

    test("Should accept a valid paired-end FASTQ samplesheet") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${validPaired.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0
            assert workflow.out.fastq.size() == 1
            assert workflow.out.sra.size() == 0
        }
    }


    test("Should accept a valid single-end FASTQ samplesheet") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${validSingle.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0
            assert workflow.out.fastq.size() == 1
            assert workflow.out.sra.size() == 0
        }
    }


    test("Should accept additional columns in a FASTQ samplesheet") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${validFastqExtraColumns.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.fastq.size() == 1
            assert workflow.out.sra.size() == 0
        }
    }


    test("Should accept reordered FASTQ columns") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${validFastqReorderedColumns.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.fastq.size() == 1
            assert workflow.out.sra.size() == 0
        }
    }


    // =========================================================================
    // Valid SRA inputs
    // =========================================================================

    test("Should accept a valid SRR accession") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${validSrr.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0
            assert workflow.out.sra.size() == 1
            assert workflow.out.fastq.size() == 0
        }
    }


    test("Should accept a valid ERR accession") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${validErr.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.sra.size() == 1
            assert workflow.out.fastq.size() == 0
        }
    }


    test("Should accept a valid DRR accession") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${validDrr.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.sra.size() == 1
            assert workflow.out.fastq.size() == 0
        }
    }


    test("Should accept additional columns in an SRA samplesheet") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${validSraExtraColumns.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.sra.size() == 1
            assert workflow.out.fastq.size() == 0
        }
    }


    test("Should accept reordered SRA columns") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${validSraReorderedColumns.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.sra.size() == 1
            assert workflow.out.fastq.size() == 0
        }
    }


    // =========================================================================
    // Invalid FASTQ structure
    // =========================================================================

    test("Should reject a FASTQ samplesheet without the sample column") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${missingSampleColumn.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    test("Should reject a FASTQ samplesheet without the fastq_1 column") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${missingFastq1Column.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    test("Should reject a FASTQ samplesheet without the fastq_2 column") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${missingFastq2Column.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    // =========================================================================
    // Invalid FASTQ values
    // =========================================================================

    test("Should reject an empty sample ID in a FASTQ samplesheet") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${emptySample.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    test("Should reject an empty fastq_1 value") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${emptyFastq1.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    test("Should reject whitespace in FASTQ sample IDs") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${sampleWithWhitespace.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    test("Should reject a nonexistent FASTQ file") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${nonexistentFastq.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    test("Should reject a FASTQ file with an invalid extension") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${invalidFastqExtension.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    // =========================================================================
    // Invalid SRA structure
    // =========================================================================

    test("Should reject an SRA samplesheet without the sample column") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${sraMissingSampleColumn.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    test("Should reject an SRA samplesheet without the accession column") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${sraMissingAccessionColumn.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    // =========================================================================
    // Invalid SRA values
    // =========================================================================

    test("Should reject an empty SRA accession") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${emptyAccession.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    test("Should reject an unsupported SRA accession type") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${unsupportedSraAccession.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    test("Should reject a malformed SRA accession") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${malformedSraAccession.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    test("Should reject whitespace in SRA sample IDs") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${sraSampleWithWhitespace.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    // =========================================================================
    // Input type detection
    // =========================================================================

    test("Should reject a samplesheet containing both FASTQ and SRA columns") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${ambiguousInput.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    test("Should reject a samplesheet with an unknown input format") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${unknownInput.canonicalPath}', checkIfExists: true)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }


    // =========================================================================
    // Invalid input file
    // =========================================================================

    test("Should reject a nonexistent samplesheet") {

        when {
            workflow {
                """
                input[0] = Channel.of(
                    file('${nonexistentSamplesheet.canonicalPath}', checkIfExists: false)
                )
                """
            }
        }

        then {
            assert workflow.failed
        }
    }
}
