/*
 * Real integration test for TRANSCRIPTOME_GENERATE.
 *
 * A tiny synthetic genome and annotation are used so the expected
 * transcript sequences are known exactly.
 *
 * This also verifies that transcripts.fa.gz is persisted into the
 * supplied transcript cache directory.
 *
 * Run with:
 *
 *   nf-test test \
 *       tests/transcriptome_generate.integration.nf.test \
 *       --profile docker
 */

def rootDir = new File(".").canonicalFile

def fixtureDir = new File(
    rootDir,
    ".nf-test/generated-transcriptome-generate-integration"
)

fixtureDir.deleteDir()
fixtureDir.mkdirs()


def writeGzip = { File target, String content ->

    target.parentFile.mkdirs()

    def output = new java.util.zip.GZIPOutputStream(
        new java.io.FileOutputStream(target)
    )

    try {
        output.write(
            content.getBytes("UTF-8")
        )
    }
    finally {
        output.close()
    }
}


def readGzip = { File target ->

    def input = new java.util.zip.GZIPInputStream(
        new java.io.FileInputStream(target)
    )

    try {
        return input.getText("UTF-8")
    }
    finally {
        input.close()
    }
}


def parseFasta = { String contents ->

    def sequences = [:]
    def currentId = null

    contents.readLines().each { line ->

        if (line.startsWith('>')) {

            currentId = line
                .substring(1)
                .trim()
                .split(/\s+/)[0]

            sequences[currentId] = ''
        }
        else if (
            currentId != null &&
            !line.trim().isEmpty()
        ) {
            sequences[currentId] +=
                line.trim()
        }
    }

    sequences
}


/*
 * Synthetic genome:
 *
 * positions:
 *
 *   1-4    AAAA
 *   5-8    CCCC
 *   9-12   GGGG
 *   13-16  TTTT
 *   17-20  ACGT
 *   21-24  AAGC
 *
 * tx1 (+):
 *   AAAA + GGGG = AAAAGGGG
 *
 * tx2 (-):
 *   genomic ACGTAAGC
 *   reverse complement = GCTTACGT
 */
def genome = new File(
    fixtureDir,
    "genome.fa.gz"
)

writeGzip(
    genome,
    ">chr1\nAAAACCCCGGGGTTTTACGTAAGC\n"
)


def gtf = new File(
    fixtureDir,
    "genes.gtf.gz"
)

writeGzip(
    gtf,
    """\
chr1\tGenAbu\ttranscript\t1\t12\t.\t+\t.\tgene_id "gene1"; transcript_id "tx1";
chr1\tGenAbu\texon\t1\t4\t.\t+\t.\tgene_id "gene1"; transcript_id "tx1"; exon_number "1";
chr1\tGenAbu\texon\t9\t12\t.\t+\t.\tgene_id "gene1"; transcript_id "tx1"; exon_number "2";
chr1\tGenAbu\ttranscript\t17\t24\t.\t-\t.\tgene_id "gene2"; transcript_id "tx2";
chr1\tGenAbu\texon\t17\t20\t.\t-\t.\tgene_id "gene2"; transcript_id "tx2"; exon_number "2";
chr1\tGenAbu\texon\t21\t24\t.\t-\t.\tgene_id "gene2"; transcript_id "tx2"; exon_number "1";
""".stripIndent()
)


def transcriptCache = new File(
    fixtureDir,
    "transcript-cache"
)

transcriptCache.mkdirs()


nextflow_process {

    name "Test TRANSCRIPTOME_GENERATE integration"
    tag "integration"

    script "../modules/local/transcriptome_generate/main.nf"
    process "TRANSCRIPTOME_GENERATE"


    test("Should reconstruct and cache the expected transcript sequences") {

        when {
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        [
                            id: 'synthetic',
                            species: 'Synthetic test',
                            assembly: 'test1',
                            source: 'GenAbu',
                            release: 1
                        ],
                        file(
                            '${genome.canonicalPath}',
                            checkIfExists: true
                        ),
                        file(
                            '${gtf.canonicalPath}',
                            checkIfExists: true
                        ),
                        '${transcriptCache.canonicalPath}'
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0
            assert process.trace.tasks().size() == 1


            with(process.out.transcript_fasta) {

                assert size() == 1

                def result = get(0)

                def reference = result[0]

                def transcriptFile = path(
                    result[1]
                ).toFile()

                assert reference.id ==
                    'synthetic'

                assert transcriptFile.name ==
                    'transcripts.fa.gz'

                assert transcriptFile.exists()
                assert transcriptFile.length() > 0


                def contents = readGzip(
                    transcriptFile
                )

                def sequences = parseFasta(
                    contents
                )


                assert sequences['tx1'] ==
                    'AAAAGGGG'

                assert sequences['tx2'] ==
                    'GCTTACGT'

                assert sequences.size() == 2
            }


            /*
             * The generated transcriptome must also have been persisted
             * into the supplied cache directory.
             */
            def cachedTranscript = new File(
                transcriptCache,
                'transcripts.fa.gz'
            )

            assert cachedTranscript.exists()
            assert cachedTranscript.length() > 0

            def cachedContents = readGzip(
                cachedTranscript
            )

            def cachedSequences = parseFasta(
                cachedContents
            )

            assert cachedSequences['tx1'] ==
                'AAAAGGGG'

            assert cachedSequences['tx2'] ==
                'GCTTACGT'


            with(process.out.versions) {

                assert size() == 1

                def versions = path(
                    get(0)
                ).toFile()

                assert versions.exists()
                assert versions.text.contains(
                    'gffread:'
                )
            }
        }
    }
}