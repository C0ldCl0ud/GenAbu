def rootDir = new File(".").canonicalFile

def fixtureDir = new File(
    rootDir,
    ".nf-test/generated-gene-abundance"
)

fixtureDir.deleteDir()
fixtureDir.mkdirs()


def sample1 = new File(
    fixtureDir,
    "sample1.quant.genes.sf"
)

sample1.text = """\
Name\tLength\tEffectiveLength\tTPM\tNumReads
1\t1000\t800\t0.0\t0.0
geneA\t1000\t800\t100.0\t25.5
geneB\t500\t400\t900.0\t75.5
""".stripIndent()


def sample2 = new File(
    fixtureDir,
    "sample2.quant.genes.sf"
)

sample2.text = """\
Name\tLength\tEffectiveLength\tTPM\tNumReads
2\t1000\t800\t0.0\t0.0
geneA\t1000\t800\t200.0\t30.0
geneB\t500\t400\t800.0\t70.0
""".stripIndent()


def gtf = new File(
    fixtureDir,
    "genes.gtf"
)

gtf.text = """\
##gtf-version 3
1\ttest\tgene\t1\t1000\t.\t+\t.\tgene_id "geneA"; gene_name "Gene A";
1\ttest\ttranscript\t1\t1000\t.\t+\t.\tgene_id "geneA"; transcript_id "txA";
1\ttest\tgene\t2000\t3000\t.\t+\t.\tgene_id "geneB"; gene_name "Gene B";
1\ttest\ttranscript\t2000\t3000\t.\t+\t.\tgene_id "geneB"; transcript_id "txB";
""".stripIndent()


nextflow_process {

    name "Test GENE_ABUNDANCE"
    tag "ci"

    script "../modules/local/gene_abundance/main.nf"
    process "GENE_ABUNDANCE"

    options "-stub-run"


    test("Should emit gene count and abundance matrices") {

        when {
            process {
                """
                input[0] = Channel.value(
                    [
                        file(
                            '${sample1.canonicalPath}',
                            checkIfExists: true
                        ),
                        file(
                            '${sample2.canonicalPath}',
                            checkIfExists: true
                        )
                    ]
                )

                input[1] = Channel.value(
                    file(
                        '${gtf.canonicalPath}',
                        checkIfExists: true
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assert process.exitStatus == 0
            assert process.trace.tasks().size() == 1


            with(process.out.counts) {

                assert size() == 1

                def output = path(
                    get(0)
                ).toFile()

                assert output.name ==
                    'gene_counts.tsv'

                assert output.exists()
                assert output.length() > 0
            }


            with(process.out.abundance) {

                assert size() == 1

                def output = path(
                    get(0)
                ).toFile()

                assert output.name ==
                    'gene_abundance.tsv'

                assert output.exists()
                assert output.length() > 0
            }
        }
    }


    test("Should emit the Python version") {

        when {
            process {
                """
                input[0] = Channel.value(
                    [
                        file(
                            '${sample1.canonicalPath}',
                            checkIfExists: true
                        )
                    ]
                )

                input[1] = Channel.value(
                    file(
                        '${gtf.canonicalPath}',
                        checkIfExists: true
                    )
                )
                """
            }
        }

        then {
            assert process.success

            with(process.out.versions) {

                assert size() == 1

                def versions = path(
                    get(0)
                ).toFile()

                assert versions.text.contains(
                    'python: "3.13.7"'
                )
            }
        }
    }
}