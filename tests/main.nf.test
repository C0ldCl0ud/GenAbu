/*
 * Pipeline-level smoke tests.
 *
 * These tests verify top-level wiring:
 *   - FASTQ input is routed into FALCO and MULTIQC.
 *   - SRA input is prepared through SRA_INPUT, then routed into FALCO and MULTIQC.
 *   - PDF input is routed through PAPER_ACCESSIONS, SRA_INPUT, FALCO, and MULTIQC.
 *   - resolve_only stops after paper accession resolution.
 */

def rootDir = new File(".").canonicalFile

def fastq1 = new File(
    rootDir,
    "tests/data/SRR6357070_1.fastq.gz"
).canonicalPath

def fastq2 = new File(
    rootDir,
    "tests/data/SRR6357070_2.fastq.gz"
).canonicalPath

def fixtureDir = new File(
    rootDir,
    ".nf-test/generated-main-tests"
)

fixtureDir.mkdirs()


def validFastq = new File(
    fixtureDir,
    "valid_fastq.csv"
)

validFastq.text = """\
sample,fastq_1,fastq_2
sample1,${fastq1},${fastq2}
""".stripIndent()


def validSra = new File(
    fixtureDir,
    "valid_sra.csv"
)

validSra.text = """\
sample,accession
sample1,SRR6357070
""".stripIndent()


def validPaper = new File(
    fixtureDir,
    "paper.pdf"
)

validPaper.setText(
    "%" + "PDF-stub fixture\n",
    "UTF-8"
)


nextflow_pipeline {

    name "Pipeline smoke tests"
    tag "ci"

    script "../main.nf"

    // Never execute external bioinformatics tools in normal CI.
    options "-stub-run"


    test("Should route FASTQ input through FALCO and MULTIQC") {

        when {
            params {
                input = validFastq.canonicalPath
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            // FASTQ input bypasses SRA_INPUT.
            // FALCO + MULTIQC.
            assert workflow.trace.tasks().size() == 2
            assert workflow.trace.succeeded().size() == 2
        }
    }


    test("Should route SRA input through SRA_INPUT, FALCO, and MULTIQC") {

        when {
            params {
                input = validSra.canonicalPath
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            // SRA_PREFETCH
            // + FASTERQ_DUMP
            // + FALCO
            // + MULTIQC.
            assert workflow.trace.tasks().size() == 4
            assert workflow.trace.succeeded().size() == 4
        }
    }


    test("Should route PDF input through PAPER_ACCESSIONS and QC") {

        when {
            params {
                input = validPaper.canonicalPath
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            // PDF_TO_TEXT
            // + ACCESSION_EXTRACTOR
            // + ACCESSION_RESOLVER
            // + SRA_PREFETCH
            // + FASTERQ_DUMP
            // + FALCO
            // + MULTIQC.
            assert workflow.trace.tasks().size() == 7
            assert workflow.trace.succeeded().size() == 7
        }
    }


    test("Should stop after resolving a PDF in resolve-only mode") {

        when {
            params {
                input = validPaper.canonicalPath
                resolve_only = true
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            // PDF_TO_TEXT
            // + ACCESSION_EXTRACTOR
            // + ACCESSION_RESOLVER.
            //
            // SRA_INPUT, FALCO, and MULTIQC must not run.
            assert workflow.trace.tasks().size() == 3
            assert workflow.trace.succeeded().size() == 3
        }
    }


    test("Should accept a custom max_runs value for PDF input") {

        when {
            params {
                input = validPaper.canonicalPath
                resolve_only = true
                max_runs = 1
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            // PDF_TO_TEXT
            // + ACCESSION_EXTRACTOR
            // + ACCESSION_RESOLVER.
            assert workflow.trace.tasks().size() == 3
            assert workflow.trace.succeeded().size() == 3
        }
    }


    test("Should route PDF input through PAPER_ACCESSIONS") {

        when {
            params {
                input = validPaper.canonicalPath
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            // Three paper-resolution tasks + SRA_PREFETCH
            // + FASTERQ_DUMP + FALCO.
            assert workflow.trace.tasks().size() == 6
            assert workflow.trace.succeeded().size() == 6
        }
    }


    test("Should stop after resolving a PDF in resolve-only mode") {

        when {
            params {
                input = validPaper.canonicalPath
                resolve_only = true
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            // PDF_TO_TEXT + ACCESSION_EXTRACTOR + ACCESSION_RESOLVER.
            // SRA_INPUT and FALCO must not run.
            assert workflow.trace.tasks().size() == 3
            assert workflow.trace.succeeded().size() == 3
        }
    }

    test("Should accept a custom max_runs value for PDF input") {

        when {
            params {
                input = validPaper.canonicalPath
                resolve_only = true
                max_runs = 1
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            // PDF_TO_TEXT + ACCESSION_EXTRACTOR + ACCESSION_RESOLVER.
            assert workflow.trace.tasks().size() == 3
            assert workflow.trace.succeeded().size() == 3
        }
    }
}
