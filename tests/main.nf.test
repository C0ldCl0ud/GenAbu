/*
 * Pipeline-level smoke tests.
 *
 * These tests verify top-level orchestration:
 *
 *   - FASTQ input is routed through FALCO, CUTADAPT, and MULTIQC.
 *   - SRA input is prepared through SRA_INPUT before read processing.
 *   - PDF input is resolved before SRA and read processing.
 *   - resolve_only stops after paper accession resolution.
 *   - supplying --genome invokes REFERENCE_PREPARATION.
 *   - trimmed reads are quantified with Salmon when a genome is supplied.
 *
 * Detailed behavior of individual modules and subworkflows is tested
 * separately. This file only verifies top-level orchestration.
 */

def rootDir = new File(".").canonicalFile


def fastq1 = new File(
    rootDir,
    "tests/data/SRR6357070_1.fastq.gz"
).canonicalPath


def fastq2 = new File(
    rootDir,
    "tests/data/SRR6357070_2.fastq.gz"
).canonicalPath


def fixtureDir = new File(
    rootDir,
    ".nf-test/generated-main-tests"
)

fixtureDir.deleteDir()
fixtureDir.mkdirs()


// =============================================================================
// Input fixtures
// =============================================================================

def validFastq = new File(
    fixtureDir,
    "valid_fastq.csv"
)

validFastq.text = """\
sample,fastq_1,fastq_2
sample1,${fastq1},${fastq2}
""".stripIndent()


def validSra = new File(
    fixtureDir,
    "valid_sra.csv"
)

validSra.text = """\
sample,accession
sample1,SRR6357070
""".stripIndent()


def validPaper = new File(
    fixtureDir,
    "paper.pdf"
)

validPaper.setText(
    "%" + "PDF-stub fixture\n",
    "UTF-8"
)


/*
 * Empty persistent reference cache.
 *
 * Supplying --genome mouse therefore requires:
 *
 *   REFERENCE_DOWNLOAD
 *   TRANSCRIPTOME_GENERATE
 *   SALMON_INDEX
 */
def referenceCache = new File(
    fixtureDir,
    "reference-cache"
)

referenceCache.mkdirs()


// =============================================================================
// Pipeline tests
// =============================================================================

nextflow_pipeline {

    name "Pipeline smoke tests"
    tag "ci"

    script "../main.nf"

    /*
     * Normal continuous integration never executes the real
     * bioinformatics tools.
     */
    options "-stub-run"


    // =========================================================================
    // FASTQ without reference
    // =========================================================================

    test("Should route FASTQ input through read processing") {

        when {
            params {
                input = validFastq.canonicalPath
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            /*
             * No genome was supplied.
             *
             * FALCO
             * CUTADAPT
             * MULTIQC
             *
             * Reference preparation and Salmon quantification
             * are not invoked.
             */
            assert workflow.trace.tasks().size() == 3
            assert workflow.trace.succeeded().size() == 3
        }
    }


    // =========================================================================
    // SRA without reference
    // =========================================================================

    test("Should route SRA input through download and read processing") {

        when {
            params {
                input = validSra.canonicalPath
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            /*
             * SRA_PREFETCH
             * FASTERQ_DUMP
             * FALCO
             * CUTADAPT
             * MULTIQC
             */
            assert workflow.trace.tasks().size() == 5
            assert workflow.trace.succeeded().size() == 5
        }
    }


    // =========================================================================
    // PDF without reference
    // =========================================================================

    test("Should route PDF input through accession and read processing") {

        when {
            params {
                input = validPaper.canonicalPath
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            /*
             * PDF_TO_TEXT
             * ACCESSION_EXTRACTOR
             * ACCESSION_RESOLVER
             * SRA_PREFETCH
             * FASTERQ_DUMP
             * FALCO
             * CUTADAPT
             * MULTIQC
             */
            assert workflow.trace.tasks().size() == 8
            assert workflow.trace.succeeded().size() == 8
        }
    }


    // =========================================================================
    // resolve_only
    // =========================================================================

    test("Should stop after resolving a PDF in resolve-only mode") {

        when {
            params {
                input = validPaper.canonicalPath
                resolve_only = true
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            /*
             * PDF_TO_TEXT
             * ACCESSION_EXTRACTOR
             * ACCESSION_RESOLVER
             *
             * Nothing downstream should run.
             */
            assert workflow.trace.tasks().size() == 3
            assert workflow.trace.succeeded().size() == 3
        }
    }


    test("Should accept a custom max_runs value in resolve-only mode") {

        when {
            params {
                input = validPaper.canonicalPath
                resolve_only = true
                max_runs = 1
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            /*
             * PDF_TO_TEXT
             * ACCESSION_EXTRACTOR
             * ACCESSION_RESOLVER
             */
            assert workflow.trace.tasks().size() == 3
            assert workflow.trace.succeeded().size() == 3
        }
    }


    // =========================================================================
    // FASTQ + complete reference preparation + quantification
    // =========================================================================

    test("Should quantify trimmed FASTQ reads when genome is supplied") {

        when {
            params {
                input = validFastq.canonicalPath
                genome = 'mouse'
                reference_cache =
                    referenceCache.canonicalPath
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            /*
             * Read processing:
             *
             *   FALCO
             *   CUTADAPT
             *   MULTIQC
             *
             * Reference preparation from empty cache:
             *
             *   REFERENCE_DOWNLOAD
             *   TRANSCRIPTOME_GENERATE
             *   SALMON_INDEX
             *
             * Quantification:
             *
             *   SALMON_QUANT
             *
             * Total = 7
             */
            assert workflow.trace.tasks().size() == 7
            assert workflow.trace.succeeded().size() == 7
        }
    }
}