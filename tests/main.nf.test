/*
 * Pipeline-level smoke tests.
 *
 * These tests verify top-level wiring only:
 *   - FASTQ input is accepted and does not invoke SRA_PREFETCH.
 *   - SRA input is routed into SRA_PREFETCH.
 *
 */

def rootDir = new File(".").canonicalFile

def fastq1 = new File(
    rootDir,
    "tests/data/SRR6357070_1.fastq.gz"
).canonicalPath

def fastq2 = new File(
    rootDir,
    "tests/data/SRR6357070_2.fastq.gz"
).canonicalPath

def fixtureDir = new File(
    rootDir,
    ".nf-test/generated-main-tests"
)

fixtureDir.mkdirs()


def validFastq = new File(
    fixtureDir,
    "valid_fastq.csv"
)

validFastq.text = """\
sample,fastq_1,fastq_2
sample1,${fastq1},${fastq2}
""".stripIndent()


def validSra = new File(
    fixtureDir,
    "valid_sra.csv"
)

validSra.text = """\
sample,accession
sample1,SRR6357070
""".stripIndent()


nextflow_pipeline {

    name "Pipeline smoke tests"
    tag "ci"

    script "../main.nf"

    // Never execute external bioinformatics tools in normal CI.
    options "-stub-run"


    test("Should run from FASTQ input without invoking SRA_PREFETCH") {

        when {
            params {
                input = validFastq.canonicalPath
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            // FASTQ input emits an empty SRA channel, so no process should run yet.
            assert workflow.trace.tasks().size() == 0
        }
    }


    test("Should route SRA input through SRA_INPUT") {

        when {
            params {
                input = validSra.canonicalPath
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0

            // One SRA_PREFETCH task + one FASTERQ_DUMP task.
            assert workflow.trace.tasks().size() == 2
            assert workflow.trace.succeeded().size() == 2
        }
    }
}
